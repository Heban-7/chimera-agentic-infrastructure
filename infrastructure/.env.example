# =============================================================================
# Project Chimera — Environment Variables
# Copy this to .env in the project root and fill in your values.
# WARNING: Never commit the .env file — it contains secrets.
# =============================================================================

# --- LLM Provider (OpenRouter — OpenAI-compatible) ---
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-openrouter-api-key-here
LLM_MODEL=your-openrouter-model-name-here

# --- Redis (Episodic Memory & Task Queues) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# --- PostgreSQL (Structured/Financial Data) ---
DATABASE_URL=postgresql+asyncpg://chimera:chimera@localhost:5432/chimera_db

# --- Weaviate (Semantic Memory / Vector DB) ---
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# --- Google AI (Gemini 3 Pro / Flash) — optional ---
GOOGLE_API_KEY=

# --- Coinbase AgentKit (Agentic Commerce) ---
CDP_API_KEY_NAME=
CDP_API_KEY_PRIVATE_KEY=

# --- Twitter / X API ---
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# --- MCP Server Endpoints ---
MCP_TWITTER_ENDPOINT=http://localhost:3001/sse

# --- Governance Thresholds ---
MAX_DAILY_LIMIT_USDC=50.0
CONFIDENCE_THRESHOLD=0.90
HITL_THRESHOLD=0.70
FINANCIAL_CONFIDENCE_THRESHOLD=0.95
